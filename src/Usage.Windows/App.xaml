<Application x:Class="Usage.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Raised surface: two stacked layers, one light shadow top-left and one dark shadow bottom-right. -->
        <ControlTemplate x:Key="RaisedTemplate" TargetType="ContentControl">
            <Grid>
                <Border Background="{DynamicResource CardBack}" CornerRadius="{DynamicResource CardRadius}" Effect="{DynamicResource ShadowLight}"/>
                <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource CardRadius}" Effect="{DynamicResource ShadowDark}"/>
                <Border Background="{DynamicResource CardSheen}" CornerRadius="{DynamicResource CardRadius}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
        </ControlTemplate>
        <!-- Docked variants: only the corners facing the screen interior are rounded. -->
        <ControlTemplate x:Key="DockRightTemplate" TargetType="ContentControl">
            <Grid>
                <Border Background="{DynamicResource CardBack}" CornerRadius="{DynamicResource DockRightRadius}" Effect="{DynamicResource ShadowLight}"/>
                <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource DockRightRadius}" Effect="{DynamicResource ShadowDark}"/>
                <Border Background="{DynamicResource CardSheen}" CornerRadius="{DynamicResource DockRightRadius}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="DockLeftTemplate" TargetType="ContentControl">
            <Grid>
                <Border Background="{DynamicResource CardBack}" CornerRadius="{DynamicResource DockLeftRadius}" Effect="{DynamicResource ShadowLight}"/>
                <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="{DynamicResource DockLeftRadius}" Effect="{DynamicResource ShadowDark}"/>
                <Border Background="{DynamicResource CardSheen}" CornerRadius="{DynamicResource DockLeftRadius}" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
        </ControlTemplate>
        <!-- Both sides square: a panel that has another panel attached on each side (detail report while the forecast is open). -->
        <ControlTemplate x:Key="FlatTemplate" TargetType="ContentControl">
            <Grid>
                <Border Background="{DynamicResource CardBack}" CornerRadius="0" Effect="{DynamicResource ShadowLight}"/>
                <Border Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="{DynamicResource CardBorderThickness}" CornerRadius="0" Effect="{DynamicResource ShadowDark}"/>
                <Border Background="{DynamicResource CardSheen}" CornerRadius="0" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Card" TargetType="ContentControl">
            <Setter Property="Template" Value="{StaticResource RaisedTemplate}"/>
            <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource CardMargin}"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Soft button: raised, becomes sunken when pressed. -->
        <Style x:Key="NeuButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent">
                            <Border x:Name="light" Background="{DynamicResource CardBack}" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ShadowLightSm}"/>
                            <Border x:Name="dark" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource ButtonRadius}" Effect="{DynamicResource ShadowDarkSm}"/>
                            <Border x:Name="pressed" CornerRadius="{DynamicResource ButtonRadius}" Opacity="0" Background="{DynamicResource ShadeBrush}"/>
                            <Border x:Name="hover" CornerRadius="{DynamicResource ButtonRadius}" Opacity="0" Background="{DynamicResource HighlightBrush}" IsHitTestVisible="False"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="light" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="dark" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="pressed" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round icon button for the header. -->
        <Style x:Key="NeuRound" TargetType="Button" BasedOn="{StaticResource NeuButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="light" Background="{DynamicResource CardBack}" CornerRadius="{DynamicResource RoundRadius}" Effect="{DynamicResource ShadowLightSm}"/>
                            <Border x:Name="dark" Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource RoundRadius}" Effect="{DynamicResource ShadowDarkSm}"/>
                            <Border x:Name="pressed" Opacity="0" Background="{DynamicResource ShadeBrush}" CornerRadius="{DynamicResource RoundRadius}"/>
                            <Border x:Name="hover" Opacity="0" Background="{DynamicResource HighlightBrush}" CornerRadius="{DynamicResource RoundRadius}" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="light" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="dark" Property="Effect" Value="{x:Null}"/>
                                <Setter TargetName="pressed" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuText" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="12" Background="{DynamicResource ShadeBrush}" BorderBrush="{DynamicResource LightBrush}" BorderThickness="0,0,0,1">
                            <Border CornerRadius="12" Background="{DynamicResource BaseBrush}" Opacity="0.72">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeuCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ScrollGhost" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bar" Background="{DynamicResource ScrollThumb}" CornerRadius="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource ScrollThumbHot}"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="bar" Property="Background" Value="{DynamicResource ScrollThumbHot}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slim, discreet scrollbar: invisible track, thin rounded thumb that follows the palette and grows on hover. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollGhost}"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollGhost}"/></Track.IncreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" Margin="1,1"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollGhost}"/></Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollGhost}"/></Track.IncreaseRepeatButton>
                                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumbStyle}" Margin="1,1"/></Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>

<Window x:Class="Usage.Windows.FloatingWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="Manual" ShowActivated="False" Focusable="False"
        Topmost="True" UseLayoutRounding="True" Title="AI Usage widget">
    <Grid x:Name="Root" Margin="16,16,0,16" Background="Transparent">
        <ContentControl x:Name="Surface" Template="{StaticResource RaisedTemplate}" Focusable="False" Padding="0">
            <Grid>
                <StackPanel x:Name="Collapsed" Orientation="Vertical" Margin="7,10,6,10"/>
                <StackPanel x:Name="Expanded" Margin="16,12" Visibility="Collapsed" Width="300"/>
            </Grid>
        </ContentControl>
        <Popup x:Name="Detail" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" Focusable="False"/>
    </Grid>
</Window>
